---
import { ClientRouter, slide } from "astro:transitions";
import TabBar from "../components/TabBar.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Section identifier (e.g. "practice", "reference/grammar"). Currently
   *  informational — every page passes it but the layout doesn't render it. */
  section?: string;
  breadcrumb?: Array<{ label: string; href?: string }>;
  /** Tab root this page belongs to. Set on the three tab destinations
   *  (progress · practice · theory); pushed screens omit it and render
   *  without the bottom bar. */
  tab?: "progress" | "practice" | "theory";
}

const { title, description = "An interactive French grammar reference.", tab } = Astro.props;
const cleanTitle = title.replace(/ — La Coquille$/, "").replace(/ · La Coquille$/, "");
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <!-- interactive-widget=resizes-content: on Android (Chrome 108+) the
         layout viewport shrinks when the system keyboard opens, so
         bottom-anchored UI stays above it. iOS handles this via visual
         viewport scrolling; the attribute is ignored there. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="description" content={description} />
    <title>{cleanTitle} · La Coquille</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Self-hosted Manrope (latin + latin-ext), preloaded: the tab bar
       labels render in the real face on first paint — no FOUT swap
       mid-navigation, no third-party request. -->
    <link rel="preload" href="/fonts/manrope-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-normal-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <!-- SPA-style navigations: swaps the page instead of a full reload,
         keeps the JS context alive, and enables link prefetch. This is
         what makes grid ↔ practice navigation feel native. -->
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class={`app-shell${tab ? " with-tab" : ""}`}>
      <!-- Tab roots animate "none": the swap must be a single frame. The
           slide ran fade+slide concurrently on ::view-transition-new(main)
           and this device's WebView composites them sequentially — a
           ~240ms wash where main hadn't painted yet (you could see the
           bare background through the arriving sheet), then a ~150ms
           slide. Tab switches must be instant; the pages themselves are
           prefetched and their islands persist, so there is nothing to
           animate into place. Pushed screens (drills, feeds) keep the
           slide — opening a layer once may take its 220ms. -->
      <main id="main-content" transition:animate={tab ? "none" : slide({ duration: "0.22s" })}>
        <slot />
      </main>
      {tab && <TabBar active={tab} />}
    </div>
    <script>
      /* Tab-shell island parking — the piece transition:persist cannot do.
        persist only pairs an island with the SAME id in the incoming page;
        the three tab roots carry different islands (practice-home /
        vocab-home / none), so flipping tabs always destroyed the outgoing
        screen's Solid tree and re-hydrated from scratch on return — a
        full remount (re-reads, re-renders, lost scroll-adjacent state)
        on every switch. Instead, park the outgoing island beside <body>
        (documentElement level) before the router swaps — moveBefore keeps
        it connected, so no disconnect callbacks fire and the Solid tree
        stays live — then move it back over the fresh incoming island
        after the swap. Result: returning to a tab re-attaches the exact
        DOM node, no re-render, no re-fetch, state intact. Browsers
        without Element.moveBefore simply fall through to the old
        remount behaviour. */
      const TAB_ISLANDS: Record<string, string | null> = {
        "/": "progress-home",
        "/practice/": "practice-home",
        "/theory/": null,
      };
      /* Element.moveBefore moves a node without firing disconnect/connect
         callbacks — a plain append would run Solid's cleanup and throw the
         state away. If it's missing, skip parking entirely and let the
         swap behave as before (fresh island per visit). */
      const moveBefore = (parent: Element, node: Element, before: Element | null): boolean => {
        const m = (parent as unknown as { moveBefore?: (n: Node, c: Node | null) => void }).moveBefore;
        if (typeof m !== "function") return false;
        m.call(parent, node, before);
        return true;
      };
      /* Tab switches skip the View Transition layer entirely. Even with
         every pseudo animation set to none, running startViewTransition
         still costs the capture/composite pipeline (1-3 frames on mid-
         range phones) and can show a stale snapshot while the new frame
         is captured — the last visible artifact of a tab flip. Intercept
         before-preparation to learn the destination; when both sides are
         tab roots, run the router's swap directly. Everything else (cold
         loads, pushed screens, browser back) keeps the real transition. */
      const TAB_ROOTS = new Set(["/", "/practice/", "/theory/"]);
      let tabToTab = false;

      /* Tab-root HTML lives in a session map, so a hot tap never touches
         the network. Measured RTT from a phone to the deployment is
         ~0.8s; HTML is no-cache (deploy-safe), which means every router
         fetch revalidates — the tap froze for a full round trip before
         the (already instant) swap. First visits warm the map; the
         other two roots are also prefetched in the background right
         after load. Keyed by origin+path+search, hash excluded. The map
         dies with the SPA session: a reload starts fresh against the
         deployed site, so deploys can never serve stale HTML. */
      const tabHtml = new Map<string, string>();
      let parser: DOMParser | null = null;
      const warm = (path: string) => {
        const url = location.origin + path;
        if (![...tabHtml.keys()].some((k) => k.split("#")[0] === url)) {
          fetch(url)
            .then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))))
            .then((t) => tabHtml.set(url, t))
            .catch(() => {});
        }
      };
      document.addEventListener("astro:page-load", () => {
        if (TAB_ROOTS.has(location.pathname)) {
          for (const p of TAB_ROOTS) if (p !== location.pathname) warm(p);
        }
      }, { once: false });

      document.addEventListener("astro:before-preparation", (ev) => {
        const to = ev.to?.href ?? "";
        tabToTab = TAB_ROOTS.has(location.pathname) && TAB_ROOTS.has(new URL(to, location.href).pathname);
        if (TAB_ROOTS.has(new URL(to, location.href).pathname)) {
          const toUrl = new URL(to, location.href);
          const key = toUrl.origin + toUrl.pathname + toUrl.search;
          /* replace the router's loader: parse from the session map, and
             fall back to the network (storing the result) on a miss —
             same contract as the default loader (newDocument + enabled
             meta check), minus style-link preloading that tab pages
             never need (their CSS is inlined in the cached HTML). The
             router invokes loader() with no arguments, so close over
             the event itself. */
          const pe = ev;
          ev.loader = async () => {
            try {
              let html = tabHtml.get(key);
              if (html == null) {
                const res = await fetch(key, { signal: pe.signal });
                if (!res.ok) { pe.preventDefault(); return; }
                html = await res.text();
                tabHtml.set(key, html);
              }
              parser ??= new DOMParser();
              pe.newDocument = parser.parseFromString(html, "text/html");
              pe.newDocument.querySelectorAll("noscript").forEach((el) => el.remove());
              if (!pe.newDocument.querySelector('[name="astro-view-transitions-enabled"]')) {
                pe.preventDefault();
              }
            } catch {
              pe.preventDefault(); /* aborts the SPA nav; router falls back */
            }
          };
        }
      });
      const svt = document.startViewTransition?.bind(document);
      if (svt) {
        document.startViewTransition = (cb: () => void) => {
          if (tabToTab) {
            const done = Promise.resolve().then(cb);
            return { updateCallbackDone: done, ready: done, finished: done, skipTransition() {} } as ViewTransition;
          }
          return svt(cb);
        };
      }
      document.addEventListener("astro:before-swap", () => {
        const id = TAB_ISLANDS[location.pathname];
        if (!id) return;
        const isl = document.querySelector<HTMLElement>(`astro-island[data-astro-transition-persist="${id}"]`);
        if (isl && isl.isConnected && moveBefore(document.documentElement, isl, null)) {
          /* parked at <html> level for potentially many swaps — without
             display:none it would lay out below body as a ghost page */
          isl.style.display = "none";
        }
      });
      document.addEventListener("astro:after-swap", () => {
        const id = TAB_ISLANDS[location.pathname];
        if (!id) return;
        const fresh = document.querySelector(`astro-island[data-astro-transition-persist="${id}"]`);
        const parked =
          document.documentElement.children.length &&
          [...document.documentElement.children].find(
            (n) => n.matches?.(`astro-island[data-astro-transition-persist="${id}"]`)
          );
        if (fresh && parked && fresh !== parked) {
          const host = fresh.parentNode;
          if (host instanceof Element && moveBefore(host, parked, fresh)) {
            (parked as HTMLElement).style.display = "";
            /* discard the fresh island before its hydration runs — the
               hydrator re-checks isConnected, so it never executes */
            fresh.remove();
          }
        }
      });
    </script>
  </body>
</html>
