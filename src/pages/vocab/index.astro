---
import Base from "../../layouts/Base.astro";
import VocabHome from "../../components/vocab/VocabHome";
---

<Base title="Vocab · La Coquille" tab="vocab">
  <!-- Island state across tab switches: kept alive by Base.astro's
       tab-shell parking script (see comment there). -->
  <VocabHome client:load transition:persist="vocab-home" />
</Base>

<style>
  :global(main#main-content) {
    padding: 0 0 calc(56px + var(--s-6));
    max-width: none;
  }
</style>
