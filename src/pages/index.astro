---
import Base from "../layouts/Base.astro";
import ProgressHome from "../components/ProgressHome";
---

<Base title="Progress" tab="progress">
  <!-- Island state across tab switches: Base.astro's parking script keeps
       this exact DOM node alive between swaps (see the tab-shell comment
       there). transition:persist stays as a marker for the router. -->
  <ProgressHome client:load transition:persist="progress-home" />
</Base>

<style>
  /* The homepage is a full-bleed menu; drop the content-page frame. */
  :global(main#main-content) {
    /* full-bleed menu, but keep the tab bar scroll clearance */
    padding: 0 0 calc(56px + var(--s-6));
    max-width: none;
  }
</style>
