---
import Base from "../layouts/Base.astro";
import HomepageTabs from "../components/HomepageTabs";
---

<Base title="La Coquille">
  <!-- transition:persist: navigating away and back keeps this island's
       DOM and state alive — the grid reappears exactly as it was left
       (tab, open sheet, loaded catalog) with no re-render or re-fetch. -->
  <HomepageTabs client:load transition:persist="homepage-tabs" />
</Base>

<style>
  /* The homepage is a full-bleed menu; drop the content-page frame. */
  :global(main#main-content) {
    padding: 0;
    max-width: none;
  }
</style>
