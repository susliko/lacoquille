---
import Base from "../layouts/Base.astro";
import PracticeHome from "../components/PracticeHome";
---

<Base title="La Coquille" tab="practice">
  <!-- transition:persist: navigating away and back keeps this island's
       DOM and state alive — the grid reappears exactly as it was left
       with no re-render or re-fetch. -->
  <PracticeHome client:load transition:persist="practice-home" />
</Base>

<style>
  /* The homepage is a full-bleed menu; drop the content-page frame. */
  :global(main#main-content) {
    padding: 0;
    max-width: none;
  }
</style>
