---
import { VERBS, PERSONS } from "../data/conjugations/index";
import type { TenseId, Person } from "../data/conjugations/types";

interface Props {
  tenseId: string;
  verbName?: string;
}

const { tenseId, verbName = "parler" } = Astro.props;
const verb = VERBS[verbName];

/* Periphrases are computed, never stored (same convention as the diagram). */
function periphrase(t: string, person: Person): string | null {
  const inf = verb?.infinitive;
  if (!verb || !inf) return null;
  const auxForms = (aux: string) =>
    (VERBS[aux]?.forms["present-indicatif"] ?? {}) as Record<string, string | null>;
  switch (t) {
    case "futur-proche": {
      const aller = auxForms("aller")[person];
      return aller ? `${aller} ${inf}` : null;
    }
    case "passe-recent": {
      const venir = auxForms("venir")[person];
      if (!venir) return null;
      const de = /^[aeiouéèh]/i.test(inf) ? "d'" : "de ";
      return `${venir} ${de}${inf}`;
    }
    case "present-progressif": {
      const etre = auxForms("être")[person];
      return etre ? `${etre} en train de ${inf}` : null;
    }
    default:
      return null;
  }
}
const stored = verb?.forms[tenseId as TenseId];
const forms: Record<string, string | null> | undefined = stored ??
  (periphrase(tenseId, "je") !== null
    ? Object.fromEntries(PERSONS.map((p) => [p, periphrase(tenseId, p)]))
    : undefined);
---

{forms && (
  <section class="conj-section">
    <h2>
      Conjugation —
      <span class="conj-verb-label">{verb.infinitive}</span>
      <span style="font-family: var(--font-body); font-size: 0.85rem; color: var(--text-2); font-weight: 300;">
        ({verb.translation})
      </span>
    </h2>
    <table class="conj-table">
      <thead>
        <tr>
          <th scope="col">Person</th>
          <th scope="col">Form</th>
        </tr>
      </thead>
      <tbody>
        {PERSONS.map(person => {
          let form = forms![person];
          if ((form === null || form === undefined) && (person === "elle" || person === "on")) {
            form = (forms as any)["il"] ?? null;
          }
          if (form === null || form === undefined) return null;
          const stem = verb.stem ?? verb.infinitive.slice(0, -2);
          const hasStem = form.startsWith(stem);
          return (
            <tr>
              <th scope="row">{person}</th>
              <td>
                {hasStem ? (
                  <>
                    <span class="verb-stem">{stem}</span><span class="verb-ending">{form.slice(stem.length)}</span>
                  </>
                ) : (
                  <strong>{form}</strong>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>
)}
