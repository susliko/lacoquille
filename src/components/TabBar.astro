---
/* Bottom tab bar — the app's three destinations (regroup 2026-11:
   Progress · Practice · Theory; the old Vocab tab folded into
   Practice, the manual moved to /theory and renamed).
   Server-rendered: the active tab is baked per page at build time.
   Pushed screens (settings, drills, the feed, lesson sheets) take
   no bar — they are layers, not destinations. */
interface Props {
  active: "progress" | "practice" | "theory";
}
const { active } = Astro.props;
const TABS = [
  { k: "progress", href: "/", label: "Progress" },
  { k: "practice", href: "/practice/", label: "Practice" },
  { k: "theory", href: "/theory/", label: "Theory" },
] as const;
---
<nav
  class="tab-bar"
  aria-label="Main"
  transition:persist="tab-bar"
>
  <!-- Active state = filled icon + navy ink (global.css). No background
       indicator — the press choreography is the only motion cue. -->
  {TABS.map((t) => (
    <a
      href={t.href}
      class:list={["tab", t.k === active && "on"]}
      aria-current={t.k === active ? "page" : undefined}
      data-astro-prefetch="load"
    >
      <span class="ic" aria-hidden="true">
        {/* M3 navigation bar: inactive = outline icon, active = filled.
            Both variants are server-rendered; global.css swaps display
            with the .on class. The filled dot/spine is carved in --card,
            the bar surface colour, so it reads as a punched hole. */}
        {t.k === "progress" && (<>
          <svg class="ic-o" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.2"/></svg>
          <svg class="ic-f" width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" fill="currentColor"/><circle cx="12" cy="12" r="3.2" fill="var(--card)"/></svg>
        </>)}
        {t.k === "practice" && (<>
          <svg class="ic-o" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"><path d="M7 5.5v13a.7.7 0 0 0 1.07.6l10.3-6.5a.7.7 0 0 0 0-1.2L8.07 4.9A.7.7 0 0 0 7 5.5z"/></svg>
          <svg class="ic-f" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"><path d="M7 5.5v13a.7.7 0 0 0 1.07.6l10.3-6.5a.7.7 0 0 0 0-1.2L8.07 4.9A.7.7 0 0 0 7 5.5z"/></svg>
        </>)}
        {t.k === "theory" && (<>
          <svg class="ic-o" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7C10.5 5.5 8 5 4 5.5v12.8c4-.5 6.5 0 8 1.7 1.5-1.7 4-2.2 8-1.7V5.5C16 5 13.5 5.5 12 7z"/><path d="M12 7v12.5"/></svg>
          <svg class="ic-f" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7C10.5 5.5 8 5 4 5.5v12.8c4-.5 6.5 0 8 1.7 1.5-1.7 4-2.2 8-1.7V5.5C16 5 13.5 5.5 12 7z" fill="currentColor" stroke="currentColor" stroke-width="2.1"/><path d="M12 7v12.5" stroke="var(--card)" stroke-width="2.1"/></svg>
        </>)}
      </span>
      {t.label}
    </a>
  ))}
</nav>

<script>
  /* The bar is transition:persist — one DOM node for the whole session,
     so navigation can never rebuild or crossfade it (the old bar faded
     out with the page and popped back in after the slide). The node
     carries the previous page's active tab, so re-sync it on every
     swap — after-swap runs before the first post-swap paint, so the
     highlight never draws a stale tab even though the swap itself is
     animation-free (tab roots, see Base.astro). Pushed screens have no
     bar — guard for that. */
  const syncTabs = () => {
    const bar = document.querySelector(".tab-bar");
    if (!bar) return;
    const path = location.pathname;
    for (const a of bar.querySelectorAll<HTMLAnchorElement>("a.tab")) {
      const on = a.pathname === path;
      a.classList.toggle("on", on);
      if (on) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    }
  };

  /* Activation is deliberately motionless: the fill variant swaps in
     one frame and the ink crossfades (160ms, global.css). An icon that
     scales or pops at nav-bar size reads as a twitch — reviewed and
     removed. The bar opts out of the expanding ripple for the same
     reason (Base.astro); its press feel is the :active compression,
     the ::after state-layer veil and an 8ms haptic tick — opacity
     fades, nothing that moves or grows. */

  syncTabs();
  window.addEventListener("resize", syncTabs);
  document.addEventListener("astro:after-swap", syncTabs);
  document.addEventListener("astro:page-load", syncTabs);

  /* Per-tab scroll memory. Tab roots share the document scroller.
     Astro 6 resets the scroller to top AT NAVIGATION START — inside
     its click handler, before astro:before-swap ever fires — so a
     save in before-swap always reads 0. Save on the click itself in
     the CAPTURE phase instead: this listener runs before the
     router's document-level click handler can touch the scroller.
     Restore on arrival (page-load), only from the top: on push
     arrivals the scroller was just reset, so scrollY is 0 whenever
     the restore is legitimate, and a late-firing restore in a
     throttled renderer can never clobber a scroll the user already
     made; on browser-back the browser restored natively and we
     stand down. A one-shot pending flag makes the restore
     router-swap-only: cold loads and hard reloads keep the
     browser's own scroll behaviour. sessionStorage survives the
     swaps and reloads; keyed by pathname, tab roots only. Paths are
     normalized to the trailing-slash form: links disagree (the bar
     links "/practice/", drill back links "/practice"), and a
     raw-pathname key would silently miss on the non-slash form. */
  const TAB_ROOTS = ["/", "/practice/", "/theory/"];
  const normPath = (p: string) => (p.length > 1 && !p.endsWith("/") ? p + "/" : p);
  const MAP_KEY = "lacoquille.tabScroll.v1";
  const PEND_KEY = "lacoquille.tabScroll.pending";
  type TabScroll = Record<string, number>;
  const readMap = (): TabScroll => {
    try { return JSON.parse(sessionStorage.getItem(MAP_KEY) || "{}") as TabScroll; }
    catch { return {}; }
  };
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    const a = e.target.closest("a");
    if (!a) return;
    const path = normPath(location.pathname);
    if (!TAB_ROOTS.includes(path) || window.scrollY <= 0) return;
    const dest = normPath(new URL(a.href, location.href).pathname);
    if (dest === path) return; /* same-page link — no navigation */
    const map = readMap();
    map[path] = window.scrollY;
    try { sessionStorage.setItem(MAP_KEY, JSON.stringify(map)); } catch { /* private mode */ }
  }, true);
  document.addEventListener("astro:before-swap", () => {
    try { sessionStorage.setItem(PEND_KEY, "1"); } catch { /* private mode */ }
  });
  document.addEventListener("astro:page-load", () => {
    let pending = false;
    try { pending = sessionStorage.getItem(PEND_KEY) === "1"; sessionStorage.removeItem(PEND_KEY); }
    catch { /* private mode */ }
    if (!pending) return;
    /* Only lift from the top: on push arrivals the router just reset the
       scroller, so this is always true when the restore is legitimate —
       and it makes a late-firing restore (throttled renderer) unable to
       clobber a scroll the user already made. On traverse (browser back)
       the browser restored natively and we stand down. */
    if (window.scrollY !== 0) return;
    const y = readMap()[normPath(location.pathname)];
    if (typeof y === "number" && y > 0) window.scrollTo(0, y);
  });
</script>
